.DS_Store

# Transient per-iteration handoffs and the run lock. Everything the loop
# produces that must NOT be committed lives under .loop/tmp/, so the line that
# keeps the installer out of consumer state is the same line git ignores. The
# durable copies live in .loop/state/runs/<branch>/<run-id>/reports/, masked
# and committed as evidence.
.loop/tmp/

# Python / uv build artefacts from the demo target
__pycache__/
.pytest_cache/
.venv/
*.egg-info/
